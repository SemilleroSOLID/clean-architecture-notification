#ENV Variables
TZ="UTC"
PORT=3200
NODE_ENV="development"

AMQP_URL="amqp://admin:admin@localhost:5673/"

# SMTP used to email the students. The defaults are Mailpit from docker-compose.yml (no user or password).
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for SMTP over TLS (port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Servicios Universidad de Caldas <notificaciones@ucaldas.test>"
# Front, for the "Ver mis solicitudes" link of the emails
APP_URL=http://localhost:5173

# Attempts to send each email before setting it aside in the queue event.drivent.email.failed
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=2000
